{
  "name": "@ckirby/dom-dom-dom-dommmm",
  "version": "9.1.0",
  "description": "DOM/JSDOM wrapper",
  "type": "module",
  "engines": {
    "node": ">=12.0.0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./setup": {
      "import": "./dist/setup.js",
      "require": "./setup.cjs"
    },
    "./*": "./*"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "compile": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm compile",
    "watch": "tsc --build --watch",
    "test": "pnpm lint && pnpm test:tape:difflet",
    "test:ci": "pnpm compile && pnpm lint && pnpm test:tape",
    "test:tape": "tape `find tests -name '*-test.js'`",
    "test:tape:difflet": "pnpm test:tape | tap-difflet --pessimistic",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "tp-release",
    "jsdoc": "jsdoc ./src/*.js -d docs/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chadkirby/splice-chars.git"
  },
  "author": "Chad Kirby",
  "license": "ISC",
  "devDependencies": {
    "@types/jsdom": "^21.1.1",
    "@types/node": "^26.6.5",
    "@types/tape": "^4.13.2",
    "jsdom": "^19.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tap-difflet": "^0.7.1",
    "tape": "^5.3.1",
    "tape-promise": "^4.0.0",
    "ts-node": "^10.4.0",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/chadkirby/splice-chars/issues"
  },
  "homepage": "https://github.com/chadkirby/splice-chars#readme",
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist",
    "setup.cjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
