{
  "name": "@ckirby/dom-dom-dom-dommmm",
  "version": "9.1.0",
  "description": "DOM/JSDOM wrapper",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./setup": {
      "import": "./dist/setup.js",
      "require": "./setup.cjs"
    },
    "./*": "./*"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "compile": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "pnpm compile",
    "watch": "tsc --build --watch",
    "test": "pnpm lint && vitest run",
    "test:watch": "vitest",
    "test:ci": "pnpm compile && pnpm typecheck && pnpm lint && vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "tp-release",
    "jsdoc": "jsdoc ./src/*.js -d docs/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chadkirby/dom-dom-dom-dommmm.git"
  },
  "author": "Chad Kirby",
  "license": "ISC",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "bugs": {
    "url": "https://github.com/chadkirby/dom-dom-dom-dommmm/issues"
  },
  "homepage": "https://github.com/chadkirby/dom-dom-dom-dommmm#readme",
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist",
    "setup.cjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
